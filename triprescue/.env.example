# Server Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/triprescue
DEMO_MODE=true

# Phase 3 Real Providers Switch (set to true to enable real external APIs)
REAL_PROVIDERS_ENABLED=false

# External Provider API Credentials (Optional - Mock fallbacks used if empty)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_or_routes_api_key_here

# Specific Provider Selectors (mock | aviationstack | google)
FLIGHT_PROVIDER=mock
ROUTE_PROVIDER=mock
TRAIN_PROVIDER=mock
BUS_PROVIDER=mock
HOTEL_PROVIDER=mock

# Data Freshness Thresholds (in minutes)
FLIGHT_STATUS_MAX_AGE_MINUTES=5
ROUTE_MAX_AGE_MINUTES=15

# API Quota Protection (Max external HTTP calls per autonomous recovery session)
MAX_PROVIDER_REQUESTS_PER_RECOVERY=10

# ─────────────────────────────────────────────────────────────────
# Phase 4 — LLM Agent Configuration (Google Gemini)
# ─────────────────────────────────────────────────────────────────

# Master LLM switch — set to true to enable the Gemini reasoning layer
# When false (default), the system operates fully deterministically
LLM_ENABLED=false

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model name — must be a valid model accessible via the Gemini REST API
# Current recommended value: gemini-1.5-flash (fast, low cost, good reasoning)
GEMINI_MODEL=gemini-1.5-flash

# Maximum number of output tokens per LLM call
LLM_MAX_TOKENS=1024

# LLM sampling temperature (0.0 = deterministic, 1.0 = creative)
# Keep low (0.1-0.3) for structured JSON decision output
LLM_TEMPERATURE=0.2

# Maximum LLM API calls allowed per autonomous recovery session (cost guard)
# When this limit is reached, the system falls back to deterministic DecisionEngine
LLM_MAX_CALLS_PER_RECOVERY=5

# Legacy alias — kept for backward compatibility
LLM_API_KEY=
