# Server Environment Configuration Template
PORT=5000
MONGODB_URI=
NODE_ENV=development

# Demo Mode Configuration
# When DEMO_MODE=true, the entire system operates deterministically using built-in mock providers
# and zero external API dependencies are required.
DEMO_MODE=true
REAL_PROVIDERS_ENABLED=false

# Provider Type Overrides ('mock' | 'aviationstack' | 'google')
FLIGHT_PROVIDER=mock
TRAIN_PROVIDER=mock
BUS_PROVIDER=mock
HOTEL_PROVIDER=mock
ROUTE_PROVIDER=mock

# Live API Keys (Optional - only required when REAL_PROVIDERS_ENABLED=true)
AVIATIONSTACK_API_KEY=
GOOGLE_MAPS_API_KEY=

# Gemini LLM Decision Engine (Optional - system falls back to deterministic decision engine when disabled)
LLM_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_MAX_CALLS_PER_RECOVERY=5

# Data Freshness Thresholds (Minutes)
FLIGHT_STATUS_MAX_AGE_MINUTES=5
ROUTE_MAX_AGE_MINUTES=15
MAX_PROVIDER_REQUESTS_PER_RECOVERY=10
